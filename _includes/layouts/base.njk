<!doctype html>
<html lang="{{ metadata.language }}" class="scroll-smooth">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ title or metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="stylesheet" href="/css/cyberblog.css">
		{% if isPost %}<link rel="stylesheet" href="/css/articles.css">{% endif %}
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
	</head>
	<body>
		<header class="header">
			<a class="logo-container" href="/" aria-label="CyberBlog, início">
				<img src="/images/logo.png" class="logo" alt="">
				<span class="site-title">CyberBlog</span>
			</a>
			<nav class="navigation" aria-label="Navegação principal">
				<a href="https://theeddu.github.io/PersonalPortfolioPage/" target="_blank" rel="noopener noreferrer" class="nav-link">Portfolio</a>
				<a href="/#contato" class="nav-link">Contato</a>
			</nav>
		</header>
		<main id="main">{{ content | safe }}</main>
		<footer id="contato" class="footer">
			<div class="footer-logo-container">
				<img src="/images/logo.png" class="footer-logo" alt="">
				<span class="footer-title">TheEddu</span>
			</div>
			<div class="footer-links">
				<p class="footer-text">Acesse meus perfis:</p>
				<a class="footer-link" target="_blank" rel="noopener noreferrer" href="https://github.com/TheEddu">GitHub</a><br>
				<a class="footer-link" target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/eduardo-s-b39896205/">LinkedIn</a><br>
				<a class="footer-link" target="_blank" rel="noopener noreferrer" href="https://tryhackme.com/p/TheEddu">TryHackMe</a>
				<p class="footer-copyright">&copy; 2025 The Eddu. Feito com dedicação e disciplina.</p>
			</div>
		</footer>
		<script type="module" src="/js/filter.js"></script>
	</body>
</html>
