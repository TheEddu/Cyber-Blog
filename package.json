{
	"name": "cyberblog",
	"version": "1.0.0",
	"description": "Blog sobre segurança da informação, programação e tecnologia.",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/Cyber-Blog/",
		"start": "npx @11ty/eleventy --serve --quiet",
		"start-ghpages": "npx @11ty/eleventy --pathprefix=/Cyber-Blog/ --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/TheEddu/Cyber-Blog.git"
	},
	"author": "The Eddu",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/11ty"
	},
	"bugs": {
		"url": "https://github.com/TheEddu/Cyber-Blog/issues"
	},
	"homepage": "https://github.com/TheEddu/Cyber-Blog#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.7",
		"@11ty/eleventy-img": "^7.0.0",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"cross-env": "^10.1.0",
		"luxon": "^3.7.2",
		"prismjs": "^1.30.0",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5"
	}
}
